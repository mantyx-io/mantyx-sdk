#!/usr/bin/env bash
# MANTYX SDK monorepo — run the same drift checks as CI before completing a commit.
# Enable once per clone:  git config core.hooksPath githooks
# Disable:                 git config --unset core.hooksPath
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: sync-version --check"
node scripts/sync-version.mjs --check

echo "pre-commit: sync-agent-runs-doc --check"
node scripts/sync-agent-runs-doc.mjs --check

echo "pre-commit: ruff check + format (python/)"
(
  cd "$ROOT/python"
  if command -v uv >/dev/null 2>&1; then
    uv run ruff check .
    uv run ruff format --check .
  elif python3 -m ruff --version >/dev/null 2>&1; then
    python3 -m ruff check .
    python3 -m ruff format --check .
  else
    echo "pre-commit: ruff not found — install dev deps: cd python && pip install -e '.[dev]'" >&2
    exit 1
  fi
)
